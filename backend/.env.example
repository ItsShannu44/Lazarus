# --- GitHub ---
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=replace_with_your_webhook_secret
ALLOWED_REPOS=your-user/demo-app

# --- LLMs ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Fallback LLM
FALLBACK_API_KEY=your_groq_api_key
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL=openai/gpt-oss-120b

# --- Memory ---
MONGODB_URI=
MONGODB_DB=lazarus

# --- Automation ---
WATCH_POLL_S=20
ESCALATE_ISSUE=true
DEMO_CONTROLS=true

# --- Robustness ---
MAX_CONCURRENT=1
LLM_PATIENCE_S=150
GEMINI_COOLDOWN_S=300
RERUN_INFRA=true

# --- Behaviour ---
MAX_RETRIES=2
MIN_CONFIDENCE=50
VERIFY_TIMEOUT_S=600
POLL_INTERVAL_S=10
MINUTES_SAVED_PER_FIX=45
CORS_ORIGINS=*

# --- Self-healing ---
AUTO_HEAL=true
AUTO_RETRIES=3
HEAL_DELAY_S=60
PUSH_LOW_CONFIDENCE=true
NO_RUN_GRACE_S=90